# mcp-bitcoin configuration reference.
#
# NOTE: this server does NOT read a .env file. It reads the process
# environment. This file documents the variables so you can copy them into the
# "env" block of your MCP client config. See README.md for full examples.

# --- Network ---------------------------------------------------------------
# mainnet | testnet | signet | regtest
MCP_BITCOIN_NETWORK=mainnet

# --- Backends --------------------------------------------------------------
# Configure at least one. Without any, only offline tools work.

# Bitcoin Core / Knots JSON-RPC.
# Prefer cookie auth over embedding credentials: MCP client config files are
# routinely committed to git. Leave out user:pass and the server reads
# ~/.bitcoin/.cookie automatically.
MCP_BITCOIN_CORE_URL=
# Override the cookie location if your datadir is non-standard.
MCP_BITCOIN_CORE_COOKIE_PATH=

# Electrum server. The scheme is required.
#   ssl://host:50002  or  tcp://host:50001
MCP_BITCOIN_ELECTRUM_URL=
# Accept self-signed Electrum certificates. Leaves the connection encrypted but
# UNAUTHENTICATED, so a man-in-the-middle could return fabricated balances.
# Not needed for .onion hosts, which authenticate via the address itself.
MCP_BITCOIN_ELECTRUM_ALLOW_SELF_SIGNED=false

# mempool.space, public or self-hosted.
MCP_BITCOIN_MEMPOOL_URL=

# Esplora / Blockstream, public or self-hosted.
MCP_BITCOIN_ESPLORA_URL=

# Failover order; first available backend that supports a call wins.
MCP_BITCOIN_PROVIDER_PRIORITY=core,electrum,mempool,esplora

# --- Tor -------------------------------------------------------------------
# When set, ALL backend connections route through this proxy and the server
# refuses to start if it is unreachable. socks5h:// is accepted and normalized.
MCP_BITCOIN_TOR_PROXY=

# --- Key material ----------------------------------------------------------
# Allow tools that accept a seed phrase or private key.
#
# Leave this false unless you understand that anything passed to those tools
# enters the model's context window and, on a hosted client, a cloud API and
# your saved chat history. The xpub path needs no permission and covers every
# address query. See SECURITY.md.
MCP_BITCOIN_ALLOW_MNEMONIC=false

# --- Tuning ----------------------------------------------------------------
MCP_BITCOIN_TIMEOUT=30
MCP_BITCOIN_FAILOVER_COOLDOWN=60
